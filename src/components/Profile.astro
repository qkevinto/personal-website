---
import styles from './Profile.module.scss'
import Avatar from './Avatar.astro'
import { name, role, work } from '../data/content.js'
---

<header>
  <div class={styles.avatar}>
    <Avatar />
  </div>
  <div>
    <h1 class={styles.name}>{name}</h1>
    <h2 class={styles.role}>{role}</h2>
    <span class={styles.work}>at <span set:html={work} /></span>
  </div>
</header>
